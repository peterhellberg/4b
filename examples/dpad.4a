; dpad.4a - one lit pixel per held direction button

                ; The four pixels form an inverted T:
                ;
                ;         up                 (7, 7)
                ;   left down right   (6, 8) (7, 8) (8, 8)

  lda #6
  sta r10       ; column of the left pixel
  lda #7
  sta r14       ; column of the up pixel
  sta r0        ; column of the down pixel
  sta r15       ; row of the up pixel
  lda #8
  sta r12       ; column of the right pixel
  sta r11       ; row of the left pixel
  sta r13       ; row of the right pixel
  sta r1        ; row of the down pixel
  lda #0
  sta r6        ; zero constant

@loop:
  cls           ; clear between frames
  read          ; acc = button bits
  sta r5        ; save the raw bits

  lda r5
  shl
  shl
  shl           ; lift bit 0 (left) to the top of the nibble
  shr
  shr
  shr           ; drop everything but that bit -> acc = 0/1
  sta r7
  lda r6
  ifgt r7       ; left held -> execute the flip
  flip r10, r11

  lda r5
  shl
  shl
  shr
  shr
  shr           ; isolate bit 1 (right)
  sta r7
  lda r6
  ifgt r7
  flip r12, r13

  lda r5
  shl
  shr
  shr
  shr           ; isolate bit 2 (up)
  sta r7
  lda r6
  ifgt r7
  flip r14, r15

  lda r5
  shr
  shr
  shr           ; isolate bit 3 (down)
  sta r7
  lda r6
  ifgt r7
  flip r0, r1

  jmp @loop     ; repeat forever
