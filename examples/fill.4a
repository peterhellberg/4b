; fill.4a       ; fill the entire screen

@start:         
  lda #0
  sta r1        ; y = 0
  sta r2        ; sentinel

@row:
  lda #0
  sta r0        ; x = 0

@col:
  flip r0, r1
  inc
  sta r0
  lda r0
  iflt r2       ; x > 0
  jmp @col

  lda r1
  inc
  sta r1        ; y++
  iflt r2       ; y > 0
  jmp @row

  jmp @start    ; repeat
