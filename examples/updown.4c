// updown.4c - blink a pixel while the up button is held

const UP = 4;   // button bit 2
u4 px = 8;      // pixel column
u4 py = 8;      // pixel row
u4 b;           // raw button bits

fn main() {
  for {
    b = buttons();
    if ((b & UP) != 0) {
      flip(px, py);  // toggling every frame makes it blink
    }
  }
}
