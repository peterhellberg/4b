// fill.4c - fill the entire screen

u4 x = 0;
u4 y = 0;

fn main() {
  for {
    for {
      flip(x, y);              // toggle one pixel
      x += 1;
      if (x == 0) { break; }   // wrapped past the right edge
    }
    y += 1;                    // next row (wraps back to 0)
  }                            // the second sweep toggles everything off again
}
